{
  "name": "gbgtech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"require('fs').writeFileSync('out/.nojekyll', '')\"",
    "deploy": "next build && gh-pages -d out -b gh-pages --dotfiles",
