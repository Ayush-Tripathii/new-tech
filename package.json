    "typecheck": "tsc --noEmit",
    "noise": "node scripts/make-noise.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.8.3"
  }
}
